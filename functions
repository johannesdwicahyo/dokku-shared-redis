#!/usr/bin/env bash
# Shared helpers for shared-redis. Sourced — never executed directly.
set -euo pipefail

generate_password() {
  # 16 random bytes -> 32 hex chars. Available everywhere; no openssl dep.
  od -An -tx1 -N16 /dev/urandom | tr -d ' \n'
}

validate_name() {
  local name="${1:-}"
  [[ -n "$name" ]] || return 1
  [[ "$name" =~ $PLUGIN_NAME_REGEX ]] || return 1
}

service_exists() {
  local name="$1"
  [[ -d "$PLUGIN_DATA_ROOT/$name" ]]
}

service_list() {
  [[ -d "$PLUGIN_DATA_ROOT" ]] || return 0
  local d
  for d in "$PLUGIN_DATA_ROOT"/*/; do
    [[ -d "$d" ]] || continue
    local name="${d%/}"
    name="${name##*/}"
    [[ "$name" == .* ]] && continue
    # `_redisdata` is the container's data volume mount, not a tenant.
    # Anything starting with `_` is reserved for plugin internals.
    [[ "$name" == _* ]] && continue
    printf '%s\n' "$name"
  done | sort
}

# Run redis-cli against the shared container as the `default` (admin) user.
# Executes inside the container via `docker exec` so the plugin does not
# require host-side redis-tools and does not depend on the container
# hostname resolving from the host.
#
# redis-cli returns exit 0 even when the Redis server rejects the command
# (e.g. ACL syntax error → "ERR ..."), which silently broke check-quotas
# in v0.1.0. We parse the first line for `^ERR ` / `^WRONGPASS ` /
# `^NOPERM ` and propagate as exit 1 so callers (and `set -e`) catch it.
run_redis_admin() {
  local pw
  pw="$(<"$PLUGIN_ADMIN_PASSWORD_FILE")"
  local out
  out="$(docker exec -i "$PLUGIN_CONTAINER_NAME" \
        redis-cli --no-auth-warning -a "$pw" "$@" 2>&1)" || return $?
  # The "AUTH failed: ERR AUTH <password>…" pre-amble is harmless noise
  # produced by `-a` against a passwordless `default` user (we use
  # --aclfile, not --requirepass, so default has no password). Strip
  # those lines before deciding if the actual command errored.
  local real
  real="$(printf '%s\n' "$out" | grep -vE '^AUTH failed: ERR AUTH ' || true)"
  if printf '%s\n' "$real" | grep -qE '^(ERR |WRONGPASS|NOPERM)'; then
    printf '%s\n' "$real" >&2
    return 1
  fi
  printf '%s\n' "$real"
}

service_dsn() {
  local name="$1"
  service_exists "$name" || { echo "service does not exist: $name" >&2; return 1; }
  local password
  password="$(<"$PLUGIN_DATA_ROOT/$name/PASSWORD")"
  printf 'redis://%s:%s@%s:%s/0\n' \
    "$name" "$password" "$PLUGIN_CONTAINER_NAME" "$PLUGIN_DB_PORT"
}

# Returns "<key_count> <memory_bytes>" for the tenant. Single Redis round
# trip via EVAL; keeps the docker stub simple for tests (one canned line).
tenant_usage() {
  local name="$1"
  local raw
  raw="$(run_redis_admin --no-raw EVAL \
    "local c='0' local n=0 local s=0 repeat local r=redis.call('SCAN',c,'MATCH',KEYS[1],'COUNT',1000) c=r[1] for i,k in ipairs(r[2]) do n=n+1 s=s+(tonumber(redis.call('MEMORY','USAGE',k)) or 0) end until c=='0' return n..' '..s" \
    1 "${name}:*" 2>/dev/null || true)"
  # Strip any surrounding quotes / whitespace.
  raw="${raw//\"/}"
  raw="${raw#"${raw%%[![:space:]]*}"}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  [[ -z "$raw" ]] && raw="0 0"
  printf '%s\n' "$raw"
}

service_info() {
  local name="$1"
  if ! service_exists "$name"; then
    echo "service does not exist: $name" >&2
    return 3
  fi

  local usage keys bytes links_csv quota_mb quota_keys violated
  usage="$(tenant_usage "$name")"
  keys="${usage% *}"
  bytes="${usage#* }"
  quota_mb="$(service_get_quota_mb "$name")"
  quota_keys="$(service_get_quota_keys "$name")"
  violated="false"
  [[ -f "$PLUGIN_DATA_ROOT/$name/QUOTA_VIOLATED" ]] && violated="true"

  if [[ -s "$PLUGIN_DATA_ROOT/$name/LINKS" ]]; then
    links_csv="$(tr '\n' ',' <"$PLUGIN_DATA_ROOT/$name/LINKS")"
    links_csv="${links_csv%,}"
  else
    links_csv=""
  fi

  printf 'name=%s\n'         "$name"
  printf 'user=%s\n'         "$name"
  printf 'key_prefix=%s:\n'  "$name"
  printf 'host=%s\n'         "$PLUGIN_CONTAINER_NAME"
  printf 'port=%s\n'         "$PLUGIN_DB_PORT"
  printf 'keys=%s\n'         "$keys"
  printf 'memory_bytes=%s\n' "$bytes"
  printf 'quota_mb=%s\n'     "$quota_mb"
  printf 'quota_keys=%s\n'   "$quota_keys"
  printf 'read_only=%s\n'    "$violated"
  printf 'linked_apps=%s\n'  "$links_csv"
}

# Make sure the shared Redis container is up. Idempotent.
ensure_shared_container() {
  local existing
  existing="$(docker ps --filter "name=^${PLUGIN_CONTAINER_NAME}$" --format '{{.Names}}' || true)"
  if [[ -n "$existing" ]]; then
    return 0
  fi

  docker network create "$PLUGIN_NETWORK_NAME" >/dev/null 2>&1 || true

  if [[ ! -s "$PLUGIN_ADMIN_PASSWORD_FILE" ]]; then
    mkdir -p "$(dirname "$PLUGIN_ADMIN_PASSWORD_FILE")"
    generate_password >"$PLUGIN_ADMIN_PASSWORD_FILE"
    chmod 600 "$PLUGIN_ADMIN_PASSWORD_FILE"
  fi

  local admin_pw
  admin_pw="$(<"$PLUGIN_ADMIN_PASSWORD_FILE")"

  # `aclfile` makes ACL SETUSER changes persist across restarts.
  # AOF is on for durability; the file lives in the same _redisdata volume.
  docker run --detach \
    --name "$PLUGIN_CONTAINER_NAME" \
    --network "$PLUGIN_NETWORK_NAME" \
    --restart always \
    -v "${PLUGIN_DATA_ROOT}/_redisdata:/data" \
    "${PLUGIN_IMAGE}:${PLUGIN_IMAGE_VERSION}" \
    redis-server \
      --requirepass "$admin_pw" \
      --appendonly yes \
      --aclfile /data/users.acl \
    >/dev/null
}

service_create() {
  local name="$1"
  validate_name "$name" || { echo "invalid tenant name: $name" >&2; return 2; }
  if service_exists "$name"; then
    echo "service already exists: $name" >&2
    return 3
  fi
  ensure_shared_container

  local pw
  pw="$(generate_password)"

  # Write metadata BEFORE issuing ACL — destroy can clean up if it fails.
  mkdir -p "$PLUGIN_DATA_ROOT/$name"
  printf '%s' "$pw"   >"$PLUGIN_DATA_ROOT/$name/PASSWORD"
  : >"$PLUGIN_DATA_ROOT/$name/LINKS"
  chmod 600 "$PLUGIN_DATA_ROOT/$name/PASSWORD"

  # ACL: scoped to keys matching "<name>:*", full command surface, login on.
  run_redis_admin ACL SETUSER "$name" on ">$pw" "~${name}:*" "+@all" >/dev/null
  # Persist the ACL file so the user survives a container restart.
  run_redis_admin ACL SAVE >/dev/null
}

# Delete every key matching "<name>:*" — used by destroy. Single round trip.
purge_tenant_keys() {
  local name="$1"
  run_redis_admin --no-raw EVAL \
    "local c='0' local n=0 repeat local r=redis.call('SCAN',c,'MATCH',KEYS[1],'COUNT',1000) c=r[1] for i,k in ipairs(r[2]) do redis.call('DEL',k) n=n+1 end until c=='0' return n" \
    1 "${name}:*" >/dev/null
}

service_destroy() {
  local name="$1"
  validate_name "$name" || { echo "invalid tenant name: $name" >&2; return 2; }
  if ! service_exists "$name"; then
    echo "service does not exist: $name" >&2
    return 3
  fi

  purge_tenant_keys "$name"
  run_redis_admin ACL DELUSER "$name" >/dev/null || true
  run_redis_admin ACL SAVE >/dev/null || true

  rm -rf "${PLUGIN_DATA_ROOT:?}/$name"
}

service_link() {
  local name="$1" app="${2:-}"
  if ! service_exists "$name"; then
    echo "service does not exist: $name" >&2
    return 3
  fi
  if [[ -z "$app" ]]; then
    echo "app name required" >&2
    return 2
  fi

  local dsn
  dsn="$(service_dsn "$name")"

  dokku config:set --no-restart "$app" "REDIS_URL=$dsn"

  local links_file="$PLUGIN_DATA_ROOT/$name/LINKS"
  if ! grep -qx "$app" "$links_file" 2>/dev/null; then
    printf '%s\n' "$app" >>"$links_file"
  fi
}

service_unlink() {
  local name="$1" app="${2:-}"
  if ! service_exists "$name"; then
    echo "service does not exist: $name" >&2
    return 3
  fi
  if [[ -z "$app" ]]; then
    echo "app name required" >&2
    return 2
  fi

  dokku config:unset --no-restart "$app" REDIS_URL || true

  local links_file="$PLUGIN_DATA_ROOT/$name/LINKS"
  if [[ -f "$links_file" ]]; then
    grep -vx "$app" "$links_file" >"${links_file}.tmp" || true
    mv "${links_file}.tmp" "$links_file"
  fi
}

service_get_quota_mb() {
  local name="$1"
  local f="$PLUGIN_DATA_ROOT/$name/QUOTA_MB"
  if [[ -s "$f" ]]; then
    cat "$f"
  else
    printf '%s' "$PLUGIN_DEFAULT_QUOTA_MB"
  fi
}

service_get_quota_keys() {
  local name="$1"
  local f="$PLUGIN_DATA_ROOT/$name/QUOTA_KEYS"
  if [[ -s "$f" ]]; then
    cat "$f"
  else
    printf '%s' "$PLUGIN_DEFAULT_QUOTA_KEYS"
  fi
}

service_set_quota() {
  local name="$1" mb="${2:-}" keys="${3:-}"
  service_exists "$name" || { echo "service does not exist: $name" >&2; return 3; }
  if [[ -z "$mb" && -z "$keys" ]]; then
    echo "at least one of --mb or --keys is required" >&2
    return 2
  fi
  if [[ -n "$mb" ]]; then
    [[ "$mb" =~ ^[1-9][0-9]*$ ]] || { echo "quota --mb must be a positive integer: $mb" >&2; return 2; }
    printf '%s' "$mb" >"$PLUGIN_DATA_ROOT/$name/QUOTA_MB"
  fi
  if [[ -n "$keys" ]]; then
    [[ "$keys" =~ ^[1-9][0-9]*$ ]] || { echo "quota --keys must be a positive integer: $keys" >&2; return 2; }
    printf '%s' "$keys" >"$PLUGIN_DATA_ROOT/$name/QUOTA_KEYS"
  fi
}

service_unset_quota() {
  local name="$1"
  service_exists "$name" || { echo "service does not exist: $name" >&2; return 3; }
  rm -f "$PLUGIN_DATA_ROOT/$name/QUOTA_MB" \
        "$PLUGIN_DATA_ROOT/$name/QUOTA_KEYS"
}

# Flip the tenant's ACL between full and read-only without losing the
# password. `ACL SETUSER` is incremental; `resetcommands` clears the
# command grant list before re-applying.
acl_set_readonly() {
  local name="$1"
  # `nocommands` (shorthand for -@all) clears the command grant list; we
  # then add back read + connection + ping. NOTE: `resetcommands` is NOT
  # valid Redis 7 ACL syntax — only `nocommands`, `-command`, and
  # `-@category` remove grants.
  run_redis_admin ACL SETUSER "$name" nocommands +@read +@connection +ping >/dev/null
  run_redis_admin ACL SAVE >/dev/null
}

acl_set_full() {
  local name="$1"
  # `allcommands` (shorthand for +@all) restores full command access.
  run_redis_admin ACL SETUSER "$name" allcommands >/dev/null
  run_redis_admin ACL SAVE >/dev/null
}

service_check_quota() {
  local name="$1"
  service_exists "$name" || { echo "service does not exist: $name" >&2; return 3; }

  local quota_mb quota_keys usage keys bytes cap_bytes
  quota_mb="$(service_get_quota_mb "$name")"
  quota_keys="$(service_get_quota_keys "$name")"
  usage="$(tenant_usage "$name")"
  keys="${usage% *}"
  bytes="${usage#* }"
  [[ -z "$keys" ]]  && keys=0
  [[ -z "$bytes" ]] && bytes=0
  cap_bytes=$((quota_mb * 1024 * 1024))

  local marker="$PLUGIN_DATA_ROOT/$name/QUOTA_VIOLATED"
  local over=false
  if (( bytes > cap_bytes )) || (( keys > quota_keys )); then
    over=true
  fi

  if $over; then
    if [[ ! -f "$marker" ]]; then
      acl_set_readonly "$name"
      : >"$marker"
      printf 'flipped name=%s keys=%s bytes=%s cap_keys=%s cap_bytes=%s -> read_only\n' \
        "$name" "$keys" "$bytes" "$quota_keys" "$cap_bytes"
    fi
  else
    if [[ -f "$marker" ]]; then
      acl_set_full "$name"
      rm -f "$marker"
      printf 'released name=%s keys=%s bytes=%s cap_keys=%s cap_bytes=%s -> writable\n' \
        "$name" "$keys" "$bytes" "$quota_keys" "$cap_bytes"
    fi
  fi
}

# Export tenant data to stdout as a sequence of redis-cli pipe-format
# RESTORE commands. Preserves TTLs (via PTTL) and all value types (via
# DUMP --no-raw). ASCII-safe so file transfer is trivial. Scans only
# keys matching <name>:* — tenant-scoped via the ACL user.
#
# Usage:
#   dokku shared-redis:export my-cache > dump.txt
service_export() {
  local name="$1"
  service_exists "$name" || { echo "service does not exist: $name" >&2; return 3; }
  local password
  password="$(<"$PLUGIN_DATA_ROOT/$name/PASSWORD")"

  local cursor=0
  while :; do
    local result batch_cursor keys
    result="$(docker exec "$PLUGIN_CONTAINER_NAME" redis-cli \
      --user "$name" --pass "$password" --no-auth-warning \
      SCAN "$cursor" MATCH "${name}:*" COUNT 1000)"
    batch_cursor="$(echo "$result" | head -1)"
    keys="$(echo "$result" | tail -n +2)"

    while IFS= read -r key; do
      [[ -z "$key" ]] && continue
      local pttl payload
      pttl="$(docker exec "$PLUGIN_CONTAINER_NAME" redis-cli \
        --user "$name" --pass "$password" --no-auth-warning PTTL "$key")"
      # -2 means key expired/vanished between SCAN and PTTL — skip it
      [[ "$pttl" == "-2" ]] && continue
      # -1 means no TTL; RESTORE uses 0 to mean "no expiry"
      [[ "$pttl" == "-1" ]] && pttl="0"
      payload="$(docker exec "$PLUGIN_CONTAINER_NAME" redis-cli \
        --user "$name" --pass "$password" --no-auth-warning --no-raw DUMP "$key" \
        | sed 's/^"\(.*\)"$/\1/')"
      [[ -z "$payload" ]] && continue
      printf 'RESTORE "%s" %s "%s" REPLACE\n' "$key" "$pttl" "$payload"
    done <<< "$keys"

    cursor="$batch_cursor"
    [[ "$cursor" == "0" ]] && break
  done
}

# Reads the export format from stdin and replays via redis-cli --pipe.
# The ACL user can only RESTORE keys matching its own prefix, so
# cross-tenant import is blocked at the Redis layer.
#
# Usage:
#   dokku shared-redis:import my-cache < dump.txt
service_import() {
  local name="$1"
  service_exists "$name" || { echo "service does not exist: $name" >&2; return 3; }
  local password
  password="$(<"$PLUGIN_DATA_ROOT/$name/PASSWORD")"
  docker exec -i "$PLUGIN_CONTAINER_NAME" redis-cli \
    --user "$name" --pass "$password" --no-auth-warning --pipe
}
